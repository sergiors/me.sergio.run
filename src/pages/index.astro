---
import Terminal from "@/components/Terminal.astro";
import { buttonVariants } from "@/components/ui/button";
import Layout from "@/layouts/layout.astro";
import { cn } from "@/lib/utils";
import { ArrowRight, Rss } from "lucide-react";

const sections = [
  {
    href: "/blog",
    label: "blog",
    description:
      "Field notes on event-driven design, serverless trade-offs and the tools I build along the way.",
    featured: true,
  },
  {
    href: "/resume",
    label: "resume",
    description:
      "The full record — roles, stack and the systems behind them, plus how to reach me.",
  },
  {
    href: "/homelab",
    label: "homelab",
    description:
      "Self-hosted services and Docker tinkering, documented as the setup grows.",
  },
];
---

<Layout title="Sérgio — Full Stack Engineer">
  <Terminal />

  <section aria-labelledby="explore-heading" class="mt-4">
    <h2 id="explore-heading" class="prompt mb-4">
      <span class="prompt-mark" aria-hidden="true">$</span>ls
    </h2>

    <ul class="grid gap-3 sm:grid-cols-2">
      {
        sections.map((section) => (
          <li>
            <a
              href={section.href}
              class={cn(
                buttonVariants({ variant: "outline" }),
                "group/button h-full w-full flex-col items-start gap-2 rounded-xl px-4 py-4 text-left whitespace-normal",
                section.featured && "sm:col-span-2",
              )}
            >
              <span class="inline-flex items-center gap-2 font-mono text-sm font-medium">
                <span class="text-primary" aria-hidden="true">
                  ./
                </span>
                {section.label}
                <ArrowRight
                  aria-hidden="true"
                  className="size-3.5 -translate-x-1 opacity-0 transition-all group-hover/button:translate-x-0 group-hover/button:opacity-100"
                />
              </span>
              <span class="text-sm font-normal text-muted-foreground">
                {section.description}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <p class="mt-8">
    <a
      href="/blog"
      class={cn(
        buttonVariants({ variant: "ghost", size: "sm" }),
        "font-mono",
      )}
    >
      <Rss aria-hidden="true" />
      read the blog
    </a>
  </p>
</Layout>
