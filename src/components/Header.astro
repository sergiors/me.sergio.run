---
import { NAV, SITE } from "@/consts";

// Normalise the trailing slash so `/blog/` and `/blog` match the same nav item.
const pathname =
  Astro.url.pathname.length > 1
    ? Astro.url.pathname.replace(/\/+$/, "")
    : Astro.url.pathname;

const isCurrent = (href: string) =>
  href === "/"
    ? pathname === "/"
    : pathname === href || pathname.startsWith(`${href}/`);
---

<header
  class="sticky top-0 z-40 border-b border-border/60 bg-background/80 backdrop-blur-sm"
>
  <nav
    aria-label="Primary"
    class="mx-auto flex w-full max-w-3xl items-center gap-4 px-4 py-3"
  >
    <a
      href="/"
      aria-label={`${SITE.name} — home`}
      class="group inline-flex shrink-0 items-center gap-2 font-mono text-sm font-medium"
    >
      <span class="text-primary" aria-hidden="true">&gt;_</span>
      <span class="hidden group-hover:underline group-hover:underline-offset-4 sm:inline"
        >sergio</span
      >
    </a>

    <ul class="ml-auto flex flex-wrap items-center justify-end gap-0.5 sm:gap-2">
      {
        NAV.map((item) => {
          const current = isCurrent(item.href);
          return (
            <li>
              <a
                href={item.href}
                aria-current={current ? "page" : undefined}
                class:list={[
                  "inline-flex items-center rounded-full px-2 py-1.5 font-mono text-xs lowercase transition-colors outline-none sm:px-3",
                  "hover:bg-muted hover:text-foreground",
                  current ? "bg-muted text-foreground" : "text-muted-foreground",
                ]}
              >
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>
