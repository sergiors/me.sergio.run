---
import { SITE, SOCIALS } from "@/consts";

const host = new URL(SITE.url).host;
---

<footer class="mt-16 border-t border-border/60">
    <div class="mx-auto flex w-full max-w-3xl flex-col gap-4 px-4 py-8">
        <div class="flex flex-col gap-2 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
            <p class="prompt" aria-hidden="true">
                <span class="text-foreground">sergio@{host}</span>
                <span>:~</span>
                <span class="text-primary">$</span>{" "}
                <span class="text-primary">_</span>
            </p>

            <ul class="flex items-center gap-4 font-mono">
                {SOCIALS.map((item) => (
                    <li>
                        <a
                            href={item.href}
                            rel="noreferrer"
                            class="rounded-sm transition-colors hover:text-foreground hover:underline hover:underline-offset-4"
                        >
                            {item.label}
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </div>
</footer>
