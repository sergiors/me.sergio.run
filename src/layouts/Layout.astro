---
import { ModeToggle } from "@/components/mode-toggle";
import { Picture } from "astro:assets";
import myself from "../assets/sergio.jpg";
import "../styles/global.css";
---

<script is:inline>
    const getThemePreference = () => {
        if (
            typeof localStorage !== "undefined" &&
            localStorage.getItem("theme")
        ) {
            return localStorage.getItem("theme");
        }
        return window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
    };
    const isDark = getThemePreference() === "dark";
    document.documentElement.classList[isDark ? "add" : "remove"]("dark");

    if (typeof localStorage !== "undefined") {
        const observer = new MutationObserver(() => {
            const isDark = document.documentElement.classList.contains("dark");
            localStorage.setItem("theme", isDark ? "dark" : "light");
        });
        observer.observe(document.documentElement, {
            attributes: true,
            attributeFilter: ["class"],
        });
    }
</script>

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <title>Astro Basics</title>
    </head>
    <body>
        <header>
            <nav class="mx-auto lg:max-w-3xl flex gap-4 items-center py-2 px-4">
                <div class="size-8 overflow-hidden rounded-full">
                    <a href="/">
                        <Picture
                            src={myself}
                            formats={["avif", "webp"]}
                            alt="Sérgio Rafael Siqueira"
                        />
                    </a>
                </div>
                <div class="ml-auto flex gap-4 items-center">
                    <ul class="flex gap-4">
                        <li><a href="/about">About</a></li>
                        <li><a href="/blog">Blog</a></li>
                        <li><a href="/homelab">Homelab</a></li>
                    </ul>
                    <ModeToggle client:load />
                </div>
            </nav>
        </header>

        <div class="mx-auto lg:max-w-3xl px-4">
            <main><slot /></main>
        </div>
    </body>
</html>
